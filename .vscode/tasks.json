{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bootRun",
      "type": "shell",
      "command": "./gradlew bootRun",
      "options": { "cwd": "${workspaceFolder}/product-management-api" },
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "continuous-compile",
      "type": "shell",
      "command": "./gradlew classes --continuous",
      "options": { "cwd": "${workspaceFolder}/product-management-api" },
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Run with Hot Reload",
      "dependsOn": ["bootRun", "continuous-compile"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
