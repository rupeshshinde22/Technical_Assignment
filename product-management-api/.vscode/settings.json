{
  "kotlin.languageServer.enabled": false,
  "kotlin.debugAdapter.enabled": false,
  "cSpell.enabled": false,
  "files.associations": {
    "*.kt": "kotlin",
    "*.kts": "kotlin"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 800,
  "files.exclude": {
    "**/.gradle": true,
    "**/build": true,
    "**/bin": true,
    "**/.kotlin": true
  }
}
